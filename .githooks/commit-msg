#!/bin/sh
# Checks that the commit message follows Conventional Commits (see "Commits" in the README).
# Turned on by `npm install` (the prepare script points core.hooksPath here).

header=$(grep -v '^#' "$1" | head -n 1)

# messages git writes itself
case "$header" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

if ! printf '%s' "$header" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$"; then
  cat >&2 <<MSG
Commit message does not follow the convention:

  $header

Use: type(optional scope): description in the imperative, no trailing period
Types: $(printf '%s' "$types" | tr '|' ' ')
Example: feat(review): add dictation practice
MSG
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "The first line has ${#header} characters; the limit is 72. Put details in the body, after a blank line." >&2
  exit 1
fi
